class Solution {
    public int lengthOfLongestSubstring(String s) {
        int l= 0;
        
        int count = 0;
       int freq[] = new int [256];
            for(int r = 0;r<s.length();r++)
            {
                char c = s.charAt(r);
                freq[c]++;
                while(freq[c]>1)
                {
                    freq[s.charAt(l)]--;
                    l++;
                }
                count = Math.max(count,r-l+1);
            }
            return count;
    }
}
