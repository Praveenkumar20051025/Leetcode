class Solution {
    public String convert(String s, int n) {
        StringBuilder b[] = new StringBuilder[n];
        for(int i =0;i<n;i++)
        {
           b[i] = new StringBuilder();
        }
        if(n == 1 || n == s.length())
        {
          return s;
        }
        int curr= 0;
        boolean flag = false;
        for(char c : s.toCharArray())
        {
            b[curr].append(c);

        
        if(curr == 0|| curr == n-1)   
        {
            flag = !flag;
        }
        if(flag)
        {
            curr++;
        }
        else{
            curr--;
        }
        }
        StringBuilder k = new StringBuilder();
        for(int i = 0 ; i<n;i++)
        {
            k.append(b[i]);
        }
        return k.toString();
         }
}
