class Solution {
    public boolean checkDivisibility(int n) {
        int result = 0;
        int temp = n;
        int sum = 0 ; 
        int prod = 1;
        while(temp>0)
        {
            int digit = temp%10;
            sum+= digit;
            prod*=digit;
             temp=temp/10;
        }
      
        result = sum+prod;
        return n%result == 0;
    }
}
